# LUNO API origin (no trailing slash), e.g. https://your-worker.workers.dev
LUNO_API_URL=

# Tenant public API key (luno_pub_…) — same host resolution as the Admin project
LUNO_PUBLIC_API_KEY=

# Form set slug — must match your LUNO form set (legacy: LUNO_BLOG_FORM_SET_SLUG)
LUNO_FORM_SET_SLUG=blog

# Must equal the Webhook signing secret configured in LUNO Admin (verify X-Luno-Signature)
LUNO_REVALIDATE_SECRET=
