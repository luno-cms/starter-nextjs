      "fieldKey": "published_at"
    }
  ],
  "provenance": {
    "sourceType": "file",
    "sourceSummary": "luno starter blueprint",
    "model": "n/a",
    "promptVersion": "2026-05-12",
    "createdAt": "2026-05-12T00:00:00.000Z"
  },
  "notes": [
    "Use entry slug as URL segment /blog/[slug]",
    "widget_role is pre-configured: embed with <div id='luno-list' data-form-set='blog' ...> + widget.js"
  ]
